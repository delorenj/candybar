{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/cron/steward_task.completed.json",
  "title": "Cron Steward Task Completed Event",
  "description": "A steward task succeeded: status succeeded, with its outcome (evaluate: Nominal|Suboptimal|Drifted|Orphaned; fix: fixed|not_fixed; enrich/refactor: done), summary, and for evaluate the report key, for fix the proving invocation. data is the task.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.cron.steward_task.completed"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "cron"
    },
    "subject": {
      "const": "bloodbank.evt.cron.steward_task.completed"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.cron.steward_task.completed/versions/1"
    },
    "schemaref": {
      "const": "bloodbank.cron.steward_task.completed.v1"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^candybar:.+$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "candybar_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "action": {
          "enum": [
            "enrich",
            "fix",
            "evaluate",
            "refactor"
          ]
        },
        "status": {
          "const": "succeeded"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "The OpenCode model ref, e.g. automaticai/auto or automaticai/auto/fast."
        },
        "parent_task_id": {
          "oneOf": [
            {
              "$ref": "../../_common/types.v1.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "A follow-up's evaluate task; null otherwise."
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The OpenCode session (ses_...)."
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_key": {
          "type": [
            "string",
            "null"
          ],
          "description": "Evaluate only: the S3 key under delo/daily-reports/."
        },
        "invocation_id": {
          "oneOf": [
            {
              "$ref": "../../_common/types.v1.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fix only: the proving invocation."
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "$ref": "../../_common/types.v1.json#/$defs/timestamp"
        },
        "started_at": {
          "oneOf": [
            {
              "$ref": "../../_common/types.v1.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "oneOf": [
            {
              "$ref": "../../_common/types.v1.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "candybar_id",
        "name",
        "action",
        "status",
        "model",
        "created_at"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "causationid",
    "producer",
    "service",
    "kind",
    "domain",
    "schemaref",
    "actor",
    "ordering_key",
    "data"
  ]
}
