{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/cron/tick.fired.json",
  "title": "Cron Tick Fired Event",
  "description": "The Candybar heartbeat publisher fired one UTC minute boundary. tick_id is deterministic (tick:<unix_epoch_minute>) and is both the ordering_key and data.tick_id; consumers key on it, never on receipt time.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.cron.tick.fired"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "cron"
    },
    "subject": {
      "const": "bloodbank.evt.cron.tick.fired"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.cron.tick.fired/versions/1"
    },
    "schemaref": {
      "const": "bloodbank.cron.tick.fired.v1"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^tick:[0-9]+$",
      "description": "Equals data.tick_id: the deterministic minute bucket."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "tick_id": {
          "type": "string",
          "pattern": "^tick:[0-9]+$",
          "description": "tick:<unix_epoch_minute>, computed from the wall-clock minute boundary."
        },
        "minute": {
          "$ref": "../../_common/types.v1.json#/$defs/timestamp",
          "description": "RFC 3339 UTC timestamp of the minute boundary this tick represents."
        }
      },
      "required": [
        "schema_version",
        "tick_id",
        "minute"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "causationid",
    "producer",
    "service",
    "kind",
    "domain",
    "schemaref",
    "actor",
    "ordering_key",
    "data"
  ]
}
