{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/cron/candybar.steward.json",
  "title": "Cron Candybar Steward Command",
  "description": "Run one steward task (enrich, fix, evaluate or refactor) for a candybar. Published by the API (POST /candybars/{id}/steward) or by an evaluate's follow-up; the task row exists before the command is consumed. The task id is the envelope id, the command id and the idempotency key. Single-consumer workqueue delivery to the candybar steward.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.cron.candybar.steward"
    },
    "kind": {
      "const": "command"
    },
    "domain": {
      "const": "cron"
    },
    "subject": {
      "const": "bloodbank.cmd.cron.candybar.steward"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.cron.candybar.steward/versions/1"
    },
    "schemaref": {
      "const": "bloodbank.cron.candybar.steward.v1"
    },
    "delivery": {
      "const": "single_consumer"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "description": "The task id."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "candybar_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "action": {
          "enum": [
            "enrich",
            "fix",
            "evaluate",
            "refactor"
          ]
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "candybar_id",
        "action"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "causationid",
    "producer",
    "service",
    "kind",
    "domain",
    "schemaref",
    "actor",
    "command_id",
    "idempotency_key",
    "delivery",
    "data"
  ]
}
