{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/cron/candybar.invoke.json",
  "title": "Cron Candybar Invoke Command",
  "description": "Dispatch one invocation of a candybar. Published by the dispatcher (trigger=scheduled/misfire, idempotency_key candybar:<id>:tick:<tick_id>) or the API (trigger=manual, idempotency_key candybar:<id>:manual:<uuid>). Single-consumer workqueue delivery to the executor.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.cron.candybar.invoke"
    },
    "kind": {
      "const": "command"
    },
    "domain": {
      "const": "cron"
    },
    "subject": {
      "const": "bloodbank.cmd.cron.candybar.invoke"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.cron.candybar.invoke/versions/1"
    },
    "schemaref": {
      "const": "bloodbank.cron.candybar.invoke.v1"
    },
    "delivery": {
      "const": "single_consumer"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^candybar:\\S+$",
      "description": "candybar:<candybar_id>:tick:<tick_id> (scheduled/misfire) or candybar:<candybar_id>:manual:<uuid> (manual). Retries of the same command present the same key."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "candybar_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "invocation_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid",
          "description": "Pre-assigned invocation identity so the executor's invoked/completed/failed facts correlate before spawn."
        },
        "trigger": {
          "enum": ["scheduled", "manual", "misfire"]
        },
        "tick_id": {
          "type": ["string", "null"],
          "pattern": "^tick:[0-9]+$",
          "description": "The tick that caused this dispatch; null for manual invokes."
        }
      },
      "required": [
        "schema_version",
        "candybar_id",
        "name",
        "invocation_id",
        "trigger",
        "tick_id"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "causationid",
    "producer",
    "service",
    "kind",
    "domain",
    "schemaref",
    "actor",
    "command_id",
    "idempotency_key",
    "delivery",
    "data"
  ]
}
