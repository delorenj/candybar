{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/cron/candybar.completed.json",
  "title": "Cron Candybar Completed Event",
  "description": "One invocation finished successfully (exit 0 or result JSON status success). Carries the per-invocation record that also lands in the invocations table.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.cron.candybar.completed"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "cron"
    },
    "subject": {
      "const": "bloodbank.evt.cron.candybar.completed"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.cron.candybar.completed/versions/1"
    },
    "schemaref": {
      "const": "bloodbank.cron.candybar.completed.v1"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^candybar:.+$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "candybar_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "invocation_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "trigger": {
          "enum": ["scheduled", "manual", "misfire"]
        },
        "tick_id": {
          "type": ["string", "null"],
          "pattern": "^tick:[0-9]+$"
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Wall-clock runtime measured by the executor."
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token_spend": {
              "type": "integer",
              "minimum": 0,
              "description": "Self-reported total tokens (input + output); 0 when unmeasured."
            },
            "cost_usd": {
              "type": ["number", "null"],
              "minimum": 0,
              "description": "Self-reported cost; null when unmeasured."
            },
            "memory_peak_bytes": {
              "type": "integer",
              "minimum": 0,
              "description": "Executor-measured peak memory (cgroup v2 memory.peak) of the invocation's scope, in bytes; 0 when unmeasured."
            },
            "cpu_load": {
              "type": "number",
              "minimum": 0,
              "description": "Executor-measured average CPU load: cgroup cpu.stat usage_usec delta / wall runtime (1.0 = one busy core); 0 when unmeasured."
            }
          },
          "required": ["token_spend", "cost_usd"]
        }
      },
      "required": [
        "schema_version",
        "candybar_id",
        "name",
        "invocation_id",
        "trigger",
        "tick_id",
        "exit_code",
        "runtime_ms",
        "metrics"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "causationid",
    "producer",
    "service",
    "kind",
    "domain",
    "schemaref",
    "actor",
    "ordering_key",
    "data"
  ]
}
