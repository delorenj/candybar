{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/cron/candybar.skipped.json",
  "title": "Cron Candybar Skipped Event",
  "description": "A fire of a candybar was suppressed: earlier missed fires coalesced to the latest after downtime (reason misfire_coalesced), or an operator skip (skip a single occurrence / the rest of a day). data.reason is a free string so new skip kinds do not force a schema revision.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.cron.candybar.skipped"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "cron"
    },
    "subject": {
      "const": "bloodbank.evt.cron.candybar.skipped"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.cron.candybar.skipped/versions/1"
    },
    "schemaref": {
      "const": "bloodbank.cron.candybar.skipped.v1"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^candybar:.+$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "candybar_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "tick_id": {
          "type": ["string", "null"],
          "pattern": "^tick:[0-9]+$",
          "description": "The suppressed fire's tick; null when the skip is not bound to one tick."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why the fire was suppressed (e.g. misfire_coalesced, manual_skip, skip_day). Free string; new kinds do not rev the schema."
        }
      },
      "required": [
        "schema_version",
        "candybar_id",
        "name",
        "tick_id",
        "reason"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "causationid",
    "producer",
    "service",
    "kind",
    "domain",
    "schemaref",
    "actor",
    "ordering_key",
    "data"
  ]
}
