{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/cron/candybar.failed.json",
  "title": "Cron Candybar Failed Event",
  "description": "One invocation failed (nonzero exit or missing result file). error.stderr_tail is redacted and limited to the last 500 characters, matching the Bloodbank reporting failure posture: no credentials, no absolute filesystem paths, no stderr dumps.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.cron.candybar.failed"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "cron"
    },
    "subject": {
      "const": "bloodbank.evt.cron.candybar.failed"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.cron.candybar.failed/versions/1"
    },
    "schemaref": {
      "const": "bloodbank.cron.candybar.failed.v1"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^candybar:.+$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "candybar_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "invocation_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "trigger": {
          "enum": ["scheduled", "manual", "misfire"]
        },
        "tick_id": {
          "type": ["string", "null"],
          "pattern": "^tick:[0-9]+$"
        },
        "exit_code": {
          "type": ["integer", "null"],
          "description": "Process exit code; null when the invocation never produced one (e.g. spawn failure)."
        },
        "runtime_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "message": {
              "type": ["string", "null"],
              "maxLength": 500,
              "description": "Short failure summary (e.g. 'exit 1', 'missing result file')."
            },
            "stderr_tail": {
              "type": "string",
              "maxLength": 500,
              "description": "Last 500 characters of captured stderr, redacted."
            },
            "redacted": {
              "const": true,
              "description": "Marks stderr_tail as redacted; always true."
            }
          },
          "required": ["message", "stderr_tail", "redacted"]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-invocation measures, same shape as candybar.completed data.metrics. Optional within revision 1 (additive).",
          "properties": {
            "token_spend": {
              "type": "integer",
              "minimum": 0,
              "description": "Self-reported total tokens (input + output); 0 when unmeasured."
            },
            "cost_usd": {
              "type": ["number", "null"],
              "minimum": 0,
              "description": "Self-reported cost; null when unmeasured."
            },
            "memory_peak_bytes": {
              "type": "integer",
              "minimum": 0,
              "description": "Executor-measured peak memory (cgroup v2 memory.peak) of the invocation's scope, in bytes; 0 when unmeasured."
            },
            "cpu_load": {
              "type": "number",
              "minimum": 0,
              "description": "Executor-measured average CPU load: cgroup cpu.stat usage_usec delta / wall runtime (1.0 = one busy core); 0 when unmeasured."
            }
          },
          "required": ["token_spend", "cost_usd"]
        }
      },
      "required": [
        "schema_version",
        "candybar_id",
        "name",
        "invocation_id",
        "trigger",
        "tick_id",
        "exit_code",
        "runtime_ms",
        "error"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "causationid",
    "producer",
    "service",
    "kind",
    "domain",
    "schemaref",
    "actor",
    "ordering_key",
    "data"
  ]
}
