{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/cron/candybar.invoked.json",
  "title": "Cron Candybar Invoked Event",
  "description": "The executor spawned one invocation of a candybar as a cgroup-scoped subprocess. Terminal outcome arrives as candybar.completed or candybar.failed.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.cron.candybar.invoked"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "cron"
    },
    "subject": {
      "const": "bloodbank.evt.cron.candybar.invoked"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.cron.candybar.invoked/versions/1"
    },
    "schemaref": {
      "const": "bloodbank.cron.candybar.invoked.v1"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^candybar:.+$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "candybar_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "invocation_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "trigger": {
          "enum": ["scheduled", "manual", "misfire"]
        },
        "tick_id": {
          "type": ["string", "null"],
          "pattern": "^tick:[0-9]+$",
          "description": "The tick that caused this invocation; null for manual invokes with no tick."
        }
      },
      "required": [
        "schema_version",
        "candybar_id",
        "name",
        "invocation_id",
        "trigger",
        "tick_id"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "causationid",
    "producer",
    "service",
    "kind",
    "domain",
    "schemaref",
    "actor",
    "ordering_key",
    "data"
  ]
}
