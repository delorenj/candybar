{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/cron/candybar.updated.json",
  "title": "Cron Candybar Updated Event",
  "description": "A registered candybar's mutable metadata changed. data.changes maps each changed field to its new value.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.cron.candybar.updated"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "cron"
    },
    "subject": {
      "const": "bloodbank.evt.cron.candybar.updated"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.cron.candybar.updated/versions/1"
    },
    "schemaref": {
      "const": "bloodbank.cron.candybar.updated.v1"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^candybar:.+$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "candybar_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "changes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true,
          "description": "Map of changed field name to its new value (e.g. schedule, description, tags, noise)."
        }
      },
      "required": [
        "schema_version",
        "candybar_id",
        "name",
        "changes"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "causationid",
    "producer",
    "service",
    "kind",
    "domain",
    "schemaref",
    "actor",
    "ordering_key",
    "data"
  ]
}
