<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>test.keepalive-service</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/true</string>
		<string>--sentinel-arg=SENTINEL-NEVER-IN-INVENTORY</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WatchPaths</key>
	<array>
		<string>/tmp/x</string>
	</array>
</dict>
</plist>
