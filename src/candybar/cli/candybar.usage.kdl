// @generated by usage-spec-typer from Typer metadata
name candybar
bin candybar
version False
about "Candybar cron framework CLI — register, invoke, and inspect scheduled candybars."
long_about "Candybar cron framework CLI — register, invoke, and inspect scheduled candybars."
flag --usage-spec help="Print usage KDL and exit."
cmd ls help="List candybars: the project's own inside a project, else the whole registry.\n\nInside a project (a git repo holding .candybar.toml or .candybars/*.candybar.toml,\nor one the registry already has candybars for) the list is that project's\ncandybars with their sync state; --global lists the registry instead.\nRegistry mode shows active candybars unless --all; archived ones only with --archived." {
    flag "-a --all" help="Include paused candybars."
    flag --archived help="Include archived candybars (hidden otherwise)."
    flag "-t --tag" help="Only candybars with this tag." {
        arg <TAG>
    }
    flag --hide-noise help="Leave out candybars in the noise collection."
    flag "-g --global" help="List the whole registry even inside a project."
    flag --json help="Print the raw API JSON."
}
cmd list help="List candybars: the project's own inside a project, else the whole registry.\n\nInside a project (a git repo holding .candybar.toml or .candybars/*.candybar.toml,\nor one the registry already has candybars for) the list is that project's\ncandybars with their sync state; --global lists the registry instead.\nRegistry mode shows active candybars unless --all; archived ones only with --archived." {
    flag "-a --all" help="Include paused candybars."
    flag --archived help="Include archived candybars (hidden otherwise)."
    flag "-t --tag" help="Only candybars with this tag." {
        arg <TAG>
    }
    flag --hide-noise help="Leave out candybars in the noise collection."
    flag "-g --global" help="List the whole registry even inside a project."
    flag --json help="Print the raw API JSON."
}
cmd show help="Show one candybar: definition, runner, totals and its latest runs." {
    flag "-n --runs" help="Recent runs to list." default="5" {
        arg <RUNS>
    }
    flag --json help="Print the raw API JSON."
    arg <ref> help="Candybar name or registry id."
}
cmd cost help="What the candybars cost to run, most expensive first.\n\nPer-day figures project each candybar's per-run average at its CURRENT\nschedule, so you can see what an interval costs before changing it. Tiers\nare green, yellow and red per dimension (CPU core-seconds, GPU-seconds,\nmemory GiB-hours, tokens, USD), the overall tier is the worst one, and\nunmeasured (hollow, grey) is never green. With a NAME it prints that\ncandybar's per-run and per-day breakdown and what hourly or daily would cost." {
    flag "-a --all" help="Include paused and archived candybars."
    flag "-n --limit" help="Rows to show (0 = every candybar)." default="20" {
        arg <LIMIT>
    }
    flag --refresh help="Recompute every candybar's cost totals first (backfill / window change)."
    flag --json help="Print the raw API JSON."
    arg "[ref]" help="One candybar's cost breakdown; omit for the ranking." required=#false
}
cmd next help="The single next fire across all candybars." {
    flag --json help="Print the raw API JSON."
}
cmd schedule help="Every fire in a window around now: past results, current, upcoming, skipped." {
    flag --ahead help="Hours after now to include." default="12" {
        arg <AHEAD>
    }
    flag --back help="Hours before now to include." default="0" {
        arg <BACK>
    }
    flag "-c --candybar" help="Only this candybar." {
        arg <CANDYBAR>
    }
    flag --hide-noise help="Leave out noise candybars (e.g. minutely smoke jobs)."
    flag --json help="Print the raw API JSON."
}
cmd history help="A candybar's recorded runs, newest first, with their measures." {
    flag "-n --runs" help="How many runs." default="20" {
        arg <RUNS>
    }
    flag --failed help="Only failed runs."
    flag --json help="Print the raw API JSON."
    arg <ref> help="Candybar name or registry id."
}
cmd pause help="Stop scheduling a candybar (it stays registered; `run` still works)." {
    arg <ref> help="Candybar name or registry id."
}
cmd resume help="Schedule a paused candybar again." {
    arg <ref> help="Candybar name or registry id."
}
cmd archive help="Archive a candybar: paused and hidden from `ls` (and Holocene) until unarchived." {
    arg <ref> help="Candybar name or registry id."
}
cmd unarchive help="Unarchive a candybar. It stays paused until `candybar resume`." {
    arg <ref> help="Candybar name or registry id."
}
cmd skip help="Skip the next fire (default), one fire (--at), or a whole day (--today / --date)." {
    flag --at help="Skip the fire at this ISO time (naive = this machine's local time)." {
        arg <AT>
    }
    flag --today help="Skip every remaining fire today (in the candybar's timezone)."
    flag --date help="Skip every fire on this YYYY-MM-DD (candybar's timezone)." {
        arg <DATE>
    }
    arg <ref> help="Candybar name or registry id."
}
cmd edit help="Change a candybar's definition (the runner/entrypoint stays with `migrate` or PATCH)." {
    flag --schedule help="New 5-field cron." {
        arg <SCHEDULE>
    }
    flag --timezone help="New IANA zone." {
        arg <TIMEZONE>
    }
    flag --name help=Rename. {
        arg <NAME>
    }
    flag --description help="New description." {
        arg <DESCRIPTION>
    }
    flag --tags help="Replace tags (comma-separated; '' clears)." {
        arg <TAGS>
    }
    flag --noise help="Add to / remove from the noise collection." negate=--no-noise
    arg <ref> help="Candybar name or registry id."
}
cmd tail help="Follow live invocations, skips and definition changes (Ctrl-C to stop)." {
    flag --ticks help="Also print the next-fire line on every tick."
    flag --hide-noise help="Leave out events of noise candybars."
    flag --json help="Print each event's JSON payload."
}
cmd create help="Create a candybar file: a step-by-step TUI, or flags with --no-tui.\n\nInside a git repo the file is .candybars/<name>.candybar.toml (or an entry\nin .candybar.toml with --project-file), so `candybar register` there picks\nit up. Outside a project it is ./<name>.candybar.toml. (Alias: `candybar new`.)" {
    flag --name help="Candybar name (lowercase slug)." {
        arg <NAME>
    }
    flag --description help="What it does." {
        arg <DESCRIPTION>
    }
    flag --tags help="Comma-separated tags." {
        arg <TAGS>
    }
    flag --schedule help="5-field cron, e.g. '0 3 * * *'." {
        arg <SCHEDULE>
    }
    flag --timezone help="IANA zone the cron is read in (default: this host's zone)." {
        arg <TIMEZONE>
    }
    flag --exec help="Run a command line, e.g. --exec \"./backup.sh --quiet\"." {
        arg <EXEC>
    }
    flag --workdir help="exec: working directory (default: project root)." {
        arg <WORKDIR>
    }
    flag --env help="exec: KEY=VAL, repeatable." var=#true {
        arg <ENV>
    }
    flag --systemd help="Start this user service unit." {
        arg <SYSTEMD>
    }
    flag --hermes help="Trigger a Hermes job: PROFILE:JOB_ID." {
        arg <HERMES>
    }
    flag --n8n help="POST to an n8n webhook: a path, or a full http(s) URL." {
        arg <N8N>
    }
    flag --data help="n8n: static JSON object handed to the workflow." {
        arg <DATA>
    }
    flag --entrypoint help="Run this executable script file." {
        arg <ENTRYPOINT>
    }
    flag --timeout help="exec/hermes/n8n: timeout in seconds." {
        arg <TIMEOUT>
    }
    flag --on-failure help="Command line run after a failure." {
        arg <ON_FAILURE>
    }
    flag --noise help="Mark the candybar as noisy."
    flag --disabled help="Create it disabled (enabled = false)."
    flag --project-file help="Append to <root>/.candybar.toml instead of its own file."
    flag --out help="Write exactly this path." {
        arg <OUT>
    }
    flag --print help="Render and validate, print the TOML, write nothing."
    flag --force help="Overwrite an existing one-candybar file."
    flag --register help="Register it through the API after writing."
    flag "-y --yes" help="Never prompt: everything comes from the flags."
}
cmd doctor help="Find clocks bypassing Candybar. Read-only; exit 0 clean, 1 bypass, 2 unknown." {
    flag --repo help="Lint tracked and untracked repo timer units." {
        arg <REPO>
    }
    flag --live help="Read machine timers, crontabs, all Hermes profiles and registry." negate=--no-live
    flag --inventory help="Audit an offline inventory JSON (no live calls)." {
        arg <INVENTORY>
    }
    flag --policy help="Exact exceptions with owner/reason." default="<candybar-install>/deploy/scheduling-policy.json" {
        arg <POLICY>
    }
    flag --n8n-export help="Optional read-only n8n workflow export JSON." {
        arg <N8N_EXPORT>
    }
    flag --write-inventory help="Save sanitized live inventory." {
        arg <WRITE_INVENTORY>
    }
    flag --json
}
cmd profile help="A candybar's steward profile: overview, project and latest evaluation." {
    flag --json help="Print the raw API JSON."
    arg <ref> help="Candybar name or registry id."
}
cmd watch help="Sync project and legacy candybar manifests on save, through the API.\n\nDiscover the current project automatically; no global enrollment is needed.\n--config retains explicit configured mode for compatibility. New registrations\nstart paused; existing pause/archive/skip state is never synchronized.\nNo polling backend, Git push, or recurring schedule is used." {
    flag "-c --config" help="Explicit legacy watcher config; otherwise discover current project." {
        arg <CONFIG>
    }
    flag --once help="Reconcile once and exit instead of watching filesystem events."
    flag --dry-run help="Preview one reconciliation without changing the registry."
    flag --if-present help="Exit quietly when this context has no manifests (shell entry hooks)."
    flag --json help="Print a one-shot report as JSON (requires --once or --dry-run)."
    arg "[path]" help="Project directory or saved manifest; defaults to current project." required=#false
}
cmd sync help="Sync the saved manifest or current project's candybars through the API.\n\nProject files validate together. Plain candybar.toml keeps legacy path rules.\nNo global config or repository enrollment is required. New jobs start paused." {
    flag --dry-run help="Validate and preview without registry writes."
    flag --json help="Machine-readable reconciliation report."
    arg "[path]" help="Saved manifest or project directory; defaults to current project." required=#false
}
cmd daemon help="Run the candybar daemon: selected roles in one asyncio process (AD-2).\n\nNATS is configured via the NATS_URL env var (default nats://localhost:4222)." {
    flag --roles help="Comma-separated roles to run, or 'all' (default). Duplicates are dropped." default=all {
        arg <ROLES>
    }
}
cmd register help="Register this project's candybars (or one manifest) and sync them with the registry.\n\nWith a PATH to a plain candybar.toml (AD-8) it is create-only. Inside a\nproject (or with a project directory or `.candybar.toml` / `.candybars/*`\nfile as PATH) it registers every candybar the project defines, creating\nthe missing ones and reporting drift; --update patches drifted fields,\n--prune archives orphans. Manifests are validated locally first (slug\nname, 5-field cron, entrypoint must exist); the API re-validates.\n\nThe API base URL comes from CANDYBAR_API_URL (default http://127.0.0.1:8700)." {
    flag "-n --name" help="Only this candybar (repeatable)." var=#true {
        arg <NAME>
    }
    flag --update help="Project mode: also PATCH drifted fields and adopt untagged candybars."
    flag --prune help="Project mode: archive registered candybars the project no longer defines."
    flag --dry-run help="Say what would change; write nothing."
    arg "[path]" help="A candybar file, a directory holding candybar.toml or project candybar files. Omit inside a project to register all of its candybars." required=#false
}
cmd run help="Invoke a registered candybar now, out of schedule (Story 1.8, AD-12).\n\nCalls POST /candybars/{id}/invoke on CANDYBAR_API_URL (default\nhttp://127.0.0.1:8700). The API publishes a trigger=manual invoke command\nand the executor runs it exactly like a scheduled fire; this command\nreturns once the invocation is accepted, not when it finishes, unless\n--wait (exit 1 on a failed run, 3 when --timeout passes first)." {
    flag "-w --wait" help="Wait for the run to finish and print its result."
    flag --timeout help="Seconds --wait gives up after (the run keeps going)." default="3600" {
        arg <TIMEOUT>
    }
    arg <candybar_ref> help="Candybar name or registry id (UUID)."
}
cmd migrate subcommand_required=#true help="Move a job from its native scheduler (systemd timer, crontab line, Hermes ticker) onto candybar, reversibly, through the committed migration ledger; or retire it for good (`decommission`). Exit codes: 0 ok, 1 refused/failed, 2 invalid ledger or unknown id, 3 pending." {
    cmd plan help="Validate entries, probe their native schedulers and print what a cutover would do." {
        flag --wave help="Only entries of this wave, e.g. 7.7." {
            arg <WAVE>
        }
        flag --write help="Fill default disable/rollback commands and unit files into the ledger."
        flag --ledger help="Ledger file (default: $CANDYBAR_LEDGER, else the checkout's deploy/migration/ledger.yaml)." {
            arg <LEDGER>
        }
        arg "[ids]…" help="Inventory ids (default: every planned entry)." required=#false var=#true
    }
    cmd cutover help="Register the candybar disabled, retire the native scheduler, enable the candybar." {
        flag --wait help="Seconds to wait for the cutover guard window to open (default 0)." default="0" {
            arg <WAIT>
        }
        flag --ledger help="Ledger file (default: $CANDYBAR_LEDGER, else the checkout's deploy/migration/ledger.yaml)." {
            arg <LEDGER>
        }
        arg <job_id> help="Inventory id of the ledger entry."
    }
    cmd verify help="Mark the entry verified by its first scheduled run since cutover (exit 3 while none)." {
        flag --ledger help="Ledger file (default: $CANDYBAR_LEDGER, else the checkout's deploy/migration/ledger.yaml)." {
            arg <LEDGER>
        }
        arg <job_id> help="Inventory id of the ledger entry."
    }
    cmd rollback help="Restore the native scheduler first, then disable the candybar (best effort; works with the daemon down)." {
        flag --reason help="Why, recorded in the entry's history." default="" {
            arg <REASON>
        }
        flag --ledger help="Ledger file (default: $CANDYBAR_LEDGER, else the checkout's deploy/migration/ledger.yaml)." {
            arg <LEDGER>
        }
        arg <job_id> help="Inventory id of the ledger entry."
    }
    cmd decommission help="Retire a job for good: native scheduler retired, candybar disabled, `rollback` refused afterwards." {
        flag --reason help="Why the job is gone for good, recorded in the entry's history." required=#true {
            arg <REASON>
        }
        flag --ledger help="Ledger file (default: $CANDYBAR_LEDGER, else the checkout's deploy/migration/ledger.yaml)." {
            arg <LEDGER>
        }
        arg <job_id> help="Inventory id of the ledger entry."
    }
    cmd status help="One line per ledger entry: status, wave, candybar and its enabled flag." {
        flag --json help="Machine-readable output."
        flag --probe help="Also probe each native scheduler."
        flag --wave help="Only entries of this wave." {
            arg <WAVE>
        }
        flag --ledger help="Ledger file (default: $CANDYBAR_LEDGER, else the checkout's deploy/migration/ledger.yaml)." {
            arg <LEDGER>
        }
    }
}
cmd steward subcommand_required=#true help="Enrich, fix and evaluate candybars through the steward." {
    cmd enrich help="Write the candybar's overview and classify its project." {
        flag "-w --wait" help="Follow the task to the end."
        flag --timeout help="Seconds --wait gives up after (the task keeps going)." default="1800" {
            arg <TIMEOUT>
        }
        flag --json help="Print the raw API JSON."
        arg <ref> help="Candybar name or registry id."
    }
    cmd fix help="Repair a drifted candybar, commit and push, and prove it with one manual run." {
        flag "-w --wait" help="Follow the task to the end."
        flag --timeout help="Seconds --wait gives up after (the task keeps going)." default="5400" {
            arg <TIMEOUT>
        }
        flag --json help="Print the raw API JSON."
        arg <ref> help="Candybar name or registry id."
    }
    cmd evaluate help="Evaluate a candybar (Nominal/Suboptimal/Drifted/Orphaned) and run the follow-up." {
        flag "-w --wait" help="Follow the task to the end."
        flag --timeout help="Seconds --wait gives up after (the task keeps going)." default="2400" {
            arg <TIMEOUT>
        }
        flag --json help="Print the raw API JSON."
        arg <ref> help="Candybar name or registry id."
    }
    cmd cancel help="Cancel a queued or running steward task and interrupt its OpenCode session." {
        flag --json help="Print the raw API JSON."
        arg <task_id> help="The steward task id."
    }
    cmd tasks help="Steward tasks, newest first." {
        flag --active help="Only queued and running tasks."
        flag "-c --candybar" help="Only this candybar." {
            arg <CANDYBAR>
        }
        flag "-n --limit" help="How many." default="30" {
            arg <LIMIT>
        }
        flag --json help="Print the raw API JSON."
    }
}
