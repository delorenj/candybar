# A no-side-effect oneshot for the `deploy-smoke-systemd` canary (Story 7.3).
#
# The canary candybar runs this through the systemd runner, so every redeploy
# can prove the whole path (drop-in, env file, start --wait, holder, metering,
# journal) on a real unit with nothing to lose. It burns a few ms of CPU and a
# little memory so the metering has something to read, and writes one journal
# line. Linked (not copied) into ~/.config/systemd/user by deploy/host/install.sh.
# It carries no install section: nothing ever starts it but the executor.

[Unit]
Description=Candybar smoke unit (systemd-runner canary, Story 7.3)
Documentation=file://%h/code/33GOD/candybar/deploy/README.md

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'head -c 8000000 /dev/zero | tail -c 1 > /dev/null; echo "candybar-smoke ok invocation=${CANDYBAR_INVOCATION_ID:-none} trigger=${CANDYBAR_TRIGGER:-none}"'
