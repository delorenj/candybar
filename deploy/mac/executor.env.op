# Secret refs for the Mac host executor (references only, never values).
# Resolved by run-executor.sh through env-op-resolve against the interim 0600
# store (~/.config/33god/secrets.env via ~/.config/33god/refmap.tsv).
# libpq reads PGPASSWORD, so the DSN in the plist stays password-free.
# Forward ref: the item does not exist in any vault; W5-2 generates the value on
# the Mac and adds the refmap row (env-op-resolve key <ref> prints the store key).
PGPASSWORD=op://DeLoSecrets/candybar-studio-registry/password
