<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Candybar executor LaunchAgent for macOS (W5-1). Rendered by install-executor.sh;
  every double-underscore token below is substituted at install time.

  Policy, enforced by tests/test_mac_profile.py:
    - RunAtLoad + KeepAlive ONLY. No StartInterval, no StartCalendarInterval:
      Candybar is the single clock and the executor is the thing that fires jobs.
    - No secret anywhere in this file. The registry DSN has no password; PGPASSWORD
      is injected by env-op-resolve from the interim 0600 store in run-executor.sh.
    - PATH is explicit. launchd would otherwise give /usr/bin:/bin:/usr/sbin:/sbin
      (Apple python 3.9, bash 3.2, no Homebrew, no mise).
    - CANDYBAR_CGROUP_ROOT is empty: macOS has no cgroup v2, so invocations run
      unscoped and memory/CPU meter as 0 (execution never depends on it).
    - Metrics and health on loopback only.
    - LimitLoadToSessionType is exactly ONE session type, chosen by install-executor.sh
      from its domain option (gui is Aqua, user is Background). Without the key user/<uid> fails to
      bootstrap ("5: Input/output error"), but listing both types would let launchd load a
      second copy into the other domain at the next login, and two executors on one durable
      can run the same exec job twice (the overlap guard is per process).
    - No ProcessType: "Background" would throttle every job the executor spawns (a 06:00
      report included), and the Linux unit sets no such limit.
    - ExitTimeOut 60 matches the Linux unit's TimeoutStopSec: the executor SIGTERMs its
      in-flight children on stop, but macOS has no cgroup sweep for one that ignores it;
      see README, "Stopping the executor".
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.33god.candybar-executor</string>
	<key>ProgramArguments</key>
	<array>
		<string>__REPO__/deploy/mac/run-executor.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__PATH__</string>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>DATABASE_URL</key>
		<string>postgresql+psycopg://candybar@127.0.0.1:__PG_PORT__/candybar</string>
		<key>NATS_URL</key>
		<string>nats://127.0.0.1:__NATS_PORT__</string>
		<key>CANDYBAR_CGROUP_ROOT</key>
		<string></string>
		<key>CANDYBAR_EXECUTOR_METRICS_HOST</key>
		<string>127.0.0.1</string>
		<key>CANDYBAR_EXECUTOR_METRICS_PORT</key>
		<string>8701</string>
		<key>CANDYBAR_NVIDIA_SMI</key>
		<string></string>
		<key>PYTHONDONTWRITEBYTECODE</key>
		<string>1</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ExitTimeOut</key>
	<integer>60</integer>
	<key>LimitLoadToSessionType</key>
	<string>__SESSION_TYPE__</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/33god/candybar-executor.out.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/33god/candybar-executor.err.log</string>
</dict>
</plist>
