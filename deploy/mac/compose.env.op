# Secret refs for deploy/compose.mac.yml (references only, never values).
# Same ref as executor.env.op: the registry container and the host executor
# must agree on one password. Run compose through the resolver:
#   env-op-resolve exec --env-file deploy/mac/compose.env.op -- \
#     docker --context colima compose -p candybar \
#       -f deploy/compose.yml -f deploy/compose.mac.yml up -d
CANDYBAR_DB_PASSWORD=op://DeLoSecrets/candybar-studio-registry/password
